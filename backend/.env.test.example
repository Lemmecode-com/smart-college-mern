# ==============================================================================
# NOVAA Smart College ERP — Test Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env.test for running automated tests locally.
# DO NOT commit backend/.env.test with real credentials to version control!
#
# DATABASE SAFETY WARNING:
# Tests using tests/setup/testDb.js execute deleteMany({}) on all collections
# in the configured database! The database name MUST be 'novaa-test'.
# ALWAYS point MONGO_URI to an isolated local or ephemeral test instance,
# NEVER to a shared, staging, or production database cluster!
# ==============================================================================

NODE_ENV=test
PORT=5001

# DATABASE CONFIGURATION
# Local isolated MongoDB test database (must target 'novaa-test')
MONGO_URI=mongodb://127.0.0.1:27017/novaa-test
DB_NAME=novaa-test

# JWT SECURITY (Dummy placeholders - 32+ characters)
JWT_SECRET=test-jwt-secret-key-32-characters-minimum-for-testing-only
# CRITICAL: Must be exactly '15m' to satisfy backend/tests/unit/auth/jwt-expiry.test.js
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EXPIRE=7d

# OPAQUE ID SECRET (Dummy placeholder)
OPAQUE_ID_SECRET=test-opaque-id-secret-placeholder-for-testing-only-32c

# ENCRYPTION MASTER KEY
# 64 hex characters (32 bytes dummy key). Must pass validateEncryptionConfig round-trip.
ENCRYPTION_MASTER_KEY=test-encryption-master-key-0123456789abcdef0123456789abcdef

# CORS CONFIGURATION
CORS_ORIGINS=http://localhost:5173

# TEST CREDENTIALS (Dummy test fixtures only)
SUPER_ADMIN_EMAIL=test-superadmin@example.com
SUPER_ADMIN_PASSWORD=TestPassword123!
TEST_SUPER_ADMIN_EMAIL=test-superadmin@example.com
TEST_SUPER_ADMIN_PASSWORD=TestPassword123!
TEST_COLLEGE_ADMIN_EMAIL=test-collegeadmin@example.com
TEST_COLLEGE_ADMIN_PASSWORD=TestPassword123!

# AUTH & RATE LIMITING
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=60000
LOGIN_LOCKOUT_MINUTES=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
