# ── DATABASE ISOLATION (ENFORCED BY CODE) ─────────────────────────────────────
#
# tests/setup/testDb.js enforces strict isolation before opening any connection:
#
#   REJECTED (will throw before network access):
#     mongodb+srv://...                   ← Atlas / cloud SRV scheme
#     mongodb://user:pass@db.host.net/…  ← any non-loopback host
#     mongodb://198.51.100.x:27017/…     ← public IP addresses
#     mongodb://127.0.0.1:27017/NOVAA    ← wrong database name
#     mongodb://127.0.0.1:27017/         ← missing database name
#
#   ALLOWED:
#     mongodb://127.0.0.1:27017/novaa-test
#     mongodb://localhost:27017/novaa-test
#     mongodb://::1:27017/novaa-test
#
#   AUTO-FALLBACK (no MONGO_URI needed):
#     If MONGO_URI is absent or USE_IN_MEMORY_DB=true, an ephemeral
#     mongodb-memory-server instance is started automatically.
#     No network connection is ever opened in that path.
#
# clearTestDb() also re-verifies the driver-reported host and database name
# immediately before any deleteMany() call (fail-closed).
#
# Connection strings are never printed to stdout or logs.
# Only sanitised metadata (host, port, dbName) is logged.
