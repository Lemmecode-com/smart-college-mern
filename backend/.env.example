# ========================
# SERVER CONFIGURATION
# ========================
PORT=5000

# Environment: development or production
NODE_ENV=development
# NODE_ENV=production

# ========================
# RATE LIMITING CONFIGURATION
# ========================
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=1000
GENERAL_RATE_LIMIT=100/ minute
AUTH_RATE_LIMIT=5/ hour
ENABLE_RATE_LIMIT=true
LOGIN_LOCKOUT_MINUTES=1

# ========================
# DATABASE CONFIGURATION
# ========================
# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?ssl=true&replicaSet=<replica>&authSource=admin&appName=<app>
# IMPORTANT: Replace with your actual MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/NOVAA?ssl=true&replicaSet=atlas-shard-0&authSource=admin&appName=Cluster0
# Alternate database connection string (used in some migration scripts)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/NOVAA?ssl=true&replicaSet=atlas-shard-0&authSource=admin&appName=Cluster0
DB_NAME=smartCollege

# ========================
# JWT SECURITY
# ========================
# CRITICAL: Generate a strong random key for production!
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum: 64 characters recommended
JWT_SECRET=<generate-strong-random-key-min-64-chars>

# JWT Token Expiry
# NOTE: JWT_ACCESS_EXPIRY is used in auth.controller.js for access/refresh token generation.
# JWT_EXPIRE is a legacy variable read by platformSupport.controller.js but not used for token generation.
# Both exist due to a documented inconsistency; ensure both are set to your desired values.
JWT_EXPIRE=7d
JWT_ACCESS_EXPIRY=2hr
JWT_REFRESH_EXPIRY=7d

# ========================
# OPAQUE ID SECRET
# ========================
# Used for generating opaque IDs (falls back to JWT_SECRET if not set)
OPAQUE_ID_SECRET=<generate-strong-random-key>

# ========================
# SUPER ADMIN CREDENTIALS
# ========================
# IMPORTANT: Use strong passwords in production!
SUPER_ADMIN_EMAIL=superadmin@smartcollege.com
SUPER_ADMIN_PASSWORD=<strong-password-min-12-chars>

# ========================
# ENCRYPTION MASTER KEY
# ========================
# CRITICAL FOR MULTI-TENANT PAYMENTS
# This key encrypts/decrypts college-specific payment gateway secrets
# MUST be at least 32 characters (64+ recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: If lost, all encrypted payment credentials become unrecoverable!
ENCRYPTION_MASTER_KEY=<generate-strong-random-key-min-64-chars>

# ========================
# FRONTEND URL CONFIGURATION
# ========================
# Development: http://localhost:5173
# Production: https://yourdomain.com
# Used for: Payment redirects, email links, CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ========================
# EMAIL CONFIGURATION
# ========================
# Gmail SMTP Settings
# IMPORTANT: Use Gmail App Password (not your main password)
# Generate: https://myaccount.google.com/apppasswords
# Steps: Enable 2FA → Create App Password → Use 16-char password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=<gmail-app-password-16-chars>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM_NAME=Smart College
EMAIL_FROM_ADDRESS=your-email@gmail.com
EMAIL_FROM=<from-name> <from-email>
EMAIL_PROVIDER=gmail
SUPPORT_EMAIL=support@college.edu

# ========================
# CORS CONFIGURATION
# ========================
# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:5174,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ========================
# GLITCHTIP ERROR TRACKING
# ========================
# Get your DSN from: https://errors.restromonitor.com
# Paste the full DSN string (includes the project key)
GLITCHTIP_DSN=https://<your-glitchtip-dsn>

# Master toggle — set to false to disable without removing the DSN
# Default: true (enabled whenever DSN is present)
GLITCHTIP_ENABLED=true

# Behavior:
# - development: errors captured, no performance tracing (tracesSampleRate=0)
# - production: errors + 10% performance tracing (tracesSampleRate=0.1)
# - NODE_ENV=production with no DSN: fully disabled, zero overhead
# No code changes needed — just set these env vars on your server

# ========================
# PAYMENT GATEWAYS (Multi-Tenant)
# ========================
# IMPORTANT: For multi-tenant SaaS, DO NOT use global keys here!
# Each college configures their own Stripe/Razorpay credentials via Admin Dashboard
# These global keys are COMMENTED OUT for security
# Only uncomment if you're using single-tenant mode (not recommended)

# Stripe (Global Fallback - COMMENTED OUT for multi-tenant)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay (Global Fallback - COMMENTED OUT for multi-tenant)
# RAZORPAY_KEY_ID=rzp_test_your_razorpay_key

# ========================
# STORAGE CONFIGURATION
# ========================
# Set the storage provider: gridfs, s3, minio, gcs, azure
# Required: true
# Default: gridfs
STORAGE_PROVIDER=gridfs

# GRIDFS CONFIGURATION (used when STORAGE_PROVIDER=gridfs)
# GridFS bucket name (files stored in fs.files and fs.chunks collections)
# Optional: defaults to "fs"
# GRIDFS_BUCKET_NAME=fs

# Chunk size for GridFS in bytes (optional, default 255KB)
# GRIDFS_CHUNK_SIZE=261120

# ========================
# AWS S3 STORAGE (Optional)
# ========================
# Enable AWS S3 for file uploads. Set STORAGE_PROVIDER=s3
# CLOUD_STORAGE_ACCESS_KEY_ID=your_aws_access_key
# CLOUD_STORAGE_SECRET_ACCESS_KEY=your_aws_secret_key
# CLOUD_STORAGE_REGION=ap-south-1
# CLOUD_STORAGE_BUCKET_NAME=your-bucket-name
# CLOUD_STORAGE_BUCKET_URL=https://your-bucket.s3.amazonaws.com
# CLOUD_STORAGE_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# ========================
# MinIO STORAGE (Optional)
# ========================
# Enable MinIO for file uploads. Set STORAGE_PROVIDER=minio
# CLOUD_STORAGE_ENDPOINT=http://localhost:9000
# CLOUD_STORAGE_ACCESS_KEY_ID=your_minio_access_key
# CLOUD_STORAGE_SECRET_ACCESS_KEY=your_minio_secret_key
# CLOUD_STORAGE_BUCKET_NAME=your-bucket-name

# ========================
# GOOGLE CLOUD STORAGE (Optional)
# ========================
# Enable GCS for file uploads. Set STORAGE_PROVIDER=gcs
# CLOUD_STORAGE_BUCKET_NAME=your-bucket-name
# CLOUD_STORAGE_ACCESS_KEY_ID=path/to/service-account-key.json

# ========================
# AZURE BLOB STORAGE (Optional)
# ========================
# Enable Azure Blob for file uploads. Set STORAGE_PROVIDER=azure
# CLOUD_STORAGE_ACCESS_KEY_ID=your_azure_account_name
# CLOUD_STORAGE_SECRET_ACCESS_KEY=your_azure_account_key
# CLOUD_STORAGE_BUCKET_NAME=your-container-name

# ========================
# FEATURE FLAGS
# ========================
# Toggle platform features via environment variables
ENABLE_2FA=false
ENABLE_AUDIT_LOGS=true
ENABLE_MONITORING=false
MAINTENANCE_MODE=false
NEW_ADMISSION_FLOW=false

# ========================
# TEST CREDENTIALS (Development Only)
# ========================
# These are used for API testing (backend/test.js)
# DO NOT use production credentials for testing!
TEST_SUPER_ADMIN_EMAIL=superadmin@smartcollege.com
TEST_SUPER_ADMIN_PASSWORD=<test-password>
TEST_COLLEGE_ADMIN_EMAIL=collegeadmin@example.com
TEST_COLLEGE_ADMIN_PASSWORD=<test-password>

# ========================
# SECURITY NOTES
# ========================
# 1. NEVER commit .env to version control (it's in .gitignore)
# 2. Use strong, randomly generated secrets for production
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. Store production secrets in secure vault (AWS Secrets Manager, etc.)
