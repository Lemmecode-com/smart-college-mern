# Production Frontend Configuration
# This file is loaded automatically during `vite build` (NODE_ENV=production)

# API Base URL - use relative path for same-origin deployments (recommended)
VITE_API_BASE_URL=/api

# For separate-origin deployments, uncomment and set your actual API URL:
# VITE_API_BASE_URL=https://your-api-domain.com/api

# Frontend URL Configuration
VITE_FRONTEND_URL=https://your-production-domain.com

# Disable frontend logging in production
VITE_ENABLE_LOGGING=false

# GlitchTip / Sentry Frontend Configuration
VITE_GLITCHTIP_DSN=https://4229299283a848559245dd63c478fd61@errors.restromonitor.com/4
VITE_GLITCHTIP_ENABLED=true
